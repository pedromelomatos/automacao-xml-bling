FROM automacao-xml-bling:2.0-dropbox

RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*

COPY dependencias_gnre/ /wheels-gnre/
RUN pip install --no-cache-dir --no-index --find-links=/wheels-gnre lxml==6.1.3 && rm -rf /wheels-gnre

WORKDIR /app
COPY consultar_gnre.py preparar_gnre.py emitir_gnre.py organizar_xmls.py conferir_retorno_gnre.py controle_producao_gnre.py conferir_pagamento_gnre.py operacao_gnre.py ./
COPY schemas/gnre/ ./schemas/gnre/

CMD ["python", "emitir_gnre.py", "--help"]
